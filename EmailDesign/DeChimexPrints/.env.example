# ---- DE-CHIMEX PRINT HUB API environment variables ----
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__DefaultConnection=Server=db;Database=DeChimexPrintHub;User Id=app;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT config removed: MVC auth signs in via cookie, so no Jwt__SigningKey is required.

App__FrontendBaseUrl=https://dechimexprinthub.com
App__ApiBaseUrl=https://api.dechimexprinthub.com
App__SupportEmail=hello@dechimexprinthub.com

Brevo__ApiKey=
Brevo__SenderEmail=no-reply@dechimexprinthub.com
Brevo__Enabled=false

Paystack__SecretKey=
Paystack__PublicKey=

Cors__AllowedOrigins__0=https://dechimexprinthub.com

Seed__OwnerEmail=owner@dechimexprinthub.com
Seed__OwnerPassword=CHANGE_ME_NOW
