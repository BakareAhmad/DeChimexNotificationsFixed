  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedImageExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".gif"
    ],
    "AllowedVideoExtensions": [
      ".mp4",
      ".webm"
    ],
    "AllowedDocumentExtensions": [
      ".pdf",
      ".doc",
      ".docx"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://dechimexprinthub.com",
      "https://www.dechimexprinthub.com"
    ]
  },
  "Gallery": {
    "ReEncodeExistingVideos": true
  },
  "Marketing": {
    "AllowBroadcasts": false,
    "BatchSize": 50,
    "PollIntervalSeconds": 10
  },
  "Seed": {
    "OwnerEmail": "owner@dechimexprinthub.com",
    "OwnerPassword": "ChangeMe123!",
    "OwnerFirstName": "System",
    "OwnerLastName": "Owner",
    "DeveloperEmail": "",
    "DeveloperPassword": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dechimex-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ]
  },
  "AllowedHosts": "*"
}
