@model IReadOnlyList<DeChimex.Contracts.Services.ServiceDto>
@{
    Layout = "_AdminLayout";
    var canManage = ViewBag.CanManage is true;
}
<div class="toolbar" style="display:flex;justify-content:flex-end;margin-bottom:16px">
    @if (canManage)
    {
        <a class="btn btn-primary" asp-action="Create">New service</a>
    }
</div>

<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Name</th><th>Base price</th><th>Featured</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                    var es = new EmptyState(EmptyIcons.Wrench, "No services yet", "Services you publish appear on the public Services page.", CtaHref: canManage ? "/admin/services/create" : null, CtaText: "New service");
                <tr><td colspan="5" class="table-empty">
                <partial name="_EmptyState" model="es" /></td></tr>
            }
            @foreach (var s in Model)
            {
                <tr>
                    <td class="font-semibold">@s.Name</td>
                    <td>₦@s.BasePrice.ToString("N2")</td>
                    <td>@if (s.IsFeatured) { <span class="badge badge-primary">Featured</span> }</td>
                    <td>@if (s.IsActive) { <span class="badge badge-success">Active</span> } else { <span class="badge badge-neutral">Inactive</span> }</td>
                    <td style="text-align:right">
                        @if (canManage)
                        {
                            <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this service?');">
                                <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger)">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
