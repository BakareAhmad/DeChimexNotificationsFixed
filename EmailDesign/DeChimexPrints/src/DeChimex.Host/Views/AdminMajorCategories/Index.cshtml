@model IReadOnlyList<DeChimex.Contracts.Categories.MajorCategoryDto>
@{ Layout = "_AdminLayout"; }
<div class="toolbar mb-4">
 @if (ViewBag.CanManage is true) { <a class="btn btn-primary" asp-action="Create">New major category</a> }
 <a class="btn btn-secondary" href="/admin/categories">Manage subcategories</a>
 <a class="btn btn-secondary" href="/admin/categories?unassigned=true">Unassigned subcategories</a>
</div>
<div class="table-wrap"><table class="table">
 <thead><tr><th>Name</th><th>Description</th><th>Subcategories</th><th>Order</th><th>Actions</th></tr></thead>
 <tbody>
 @foreach (var m in Model) {
 <tr><td><a asp-action="Details" asp-route-id="@m.Id">@m.Name</a></td><td>@m.Description</td><td>@m.CategoryCount</td><td>@m.DisplayOrder</td>
 <td>@if (ViewBag.CanManage is true) {
 <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@m.Id">Edit</a>
 <form method="post" asp-action="Delete" asp-route-id="@m.Id" style="display:inline"><button class="btn btn-ghost btn-sm" type="submit">Delete</button></form>
 }</td></tr>
 }
 @if (Model.Count == 0) { <tr><td colspan="5">No major categories yet.</td></tr> }
 </tbody></table></div>
