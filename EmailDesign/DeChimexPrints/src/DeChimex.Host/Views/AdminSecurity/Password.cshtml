@model DeChimex.Host.Models.Admin.ChangePasswordFormViewModel
@{
    Layout = "_AdminLayout";
}
@if (ViewBag.Forced is true)
{
    <div class="alert alert-error mb-4" role="alert" style="border-left:4px solid var(--primary)">
        <strong>Security notice:</strong> you are signed in with the default setup password.
        Choose a new password now to continue. The rest of the admin area stays locked until this is done.
    </div>
}
<div class="card" style="max-width:520px">
    <div class="card-head"><h3>Change password</h3></div>
    <div class="card-body">
        <p class="text-sm text-muted mb-4">Use your current password to set a new one. The new password takes effect at your next sign in.</p>
        <form asp-action="Password" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4" role="alert"></div>
            <div class="field">
                <label class="label" asp-for="CurrentPassword">Current password <span class="req">*</span></label>
                <input class="input" asp-for="CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="NewPassword">New password <span class="req">*</span></label>
                <input class="input" asp-for="NewPassword" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="ConfirmPassword">Confirm new password <span class="req">*</span></label>
                <input class="input" asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <div class="mt-4">
                <button class="btn btn-primary" type="submit">Update password</button>
            </div>
        </form>
    </div>
</div>
