@model IReadOnlyList<DeChimex.Contracts.Inventory.InventoryDto>
@{
    Layout = "_AdminLayout";
}
<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Product</th><th>On hand</th><th>Reserved</th><th>Threshold</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No low-stock items.</td></tr>
            }
            @foreach (var i in Model)
            {
                <tr>
                    <td class="font-semibold">@i.ProductName</td>
                    <td>@i.QuantityOnHand</td>
                    <td>@i.QuantityReserved</td>
                    <td>@i.LowStockThreshold</td>
                    <td style="text-align:right"><a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-productId="@i.ProductId">Manage</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
