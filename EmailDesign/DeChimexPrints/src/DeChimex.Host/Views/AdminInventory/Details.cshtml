@model IReadOnlyList<DeChimex.Contracts.Inventory.InventoryTransactionDto>
@{
    Layout = "_AdminLayout";
    var productId = (Guid)ViewData["ProductId"]!;
    var canStockIn = ViewBag.CanStockIn is true;
    var canAdjust = ViewBag.CanAdjust is true;
}
<div class="toolbar mb-4" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <a class="btn btn-outline btn-sm" asp-action="Index" aria-label="Back to inventory list">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Back to list
    </a>
</div>
@if (canStockIn || canAdjust)
{
    <div class="g" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin-bottom:20px">
        @if (canStockIn)
        {
            <div class="card">
                <div class="card-head"><h3>Stock in</h3></div>
                <div class="card-body">
                    <form asp-action="StockIn" asp-route-productId="@productId" method="post">
                        <div class="field">
                            <label class="label" for="qty">Quantity</label>
                            <input class="input" type="number" name="quantity" min="1" required />
                        </div>
                        <div class="field">
                            <label class="label" for="ref">Reference</label>
                            <input class="input" type="text" name="reference" />
                        </div>
                        <div class="field">
                            <label class="label" for="notes">Notes</label>
                            <input class="input" type="text" name="notes" />
                        </div>
                        <button class="btn btn-primary" type="submit">Add stock</button>
                    </form>
                </div>
            </div>
        }
        @if (canAdjust)
        {
            <div class="card">
                <div class="card-head"><h3>Adjust stock</h3></div>
                <div class="card-body">
                    <form asp-action="Adjust" asp-route-productId="@productId" method="post">
                        <div class="field">
                            <label class="label" for="delta">Delta (+/-)</label>
                            <input class="input" type="number" name="delta" required />
                        </div>
                        <div class="field">
                            <label class="label" for="reason">Reason</label>
                            <input class="input" type="text" name="reason" required />
                        </div>
                        <button class="btn btn-primary" type="submit">Adjust</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

<div class="card">
    <div class="card-head"><h3>Stock history</h3></div>
    <div class="card-body">
        <table class="table">
            <thead><tr><th>Date</th><th>Type</th><th>Change</th><th>Resulting</th><th>Reference</th><th>By</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">No movements recorded.</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="text-muted">@t.OccurredOnUtc.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                        <td><span class="badge badge-neutral">@t.Type</span></td>
                        <td>@(t.QuantityChange >= 0 ? "+" : "")@t.QuantityChange</td>
                        <td>@t.ResultingQuantity</td>
                        <td class="text-muted">@(t.Reference ?? "-")</td>
                        <td class="text-muted">@(t.PerformedBy ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
