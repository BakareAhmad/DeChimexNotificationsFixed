@model DeChimex.Application.Features.Activity.ActivityPage
@{ Layout="_AdminLayout"; var f=(DeChimex.Application.Features.Activity.ActivityFilter)ViewBag.Filter; }
<div class="flex items-start justify-between gap-4 mb-4">
 <div><h2>Business activity</h2><p class="text-muted mt-2">A cross-business view of committed actions. Important operational events update live; routine changes appear on refresh.</p></div>
 <span id="activityConnection" class="badge badge-neutral" role="status">Connecting…</span>
</div>
@if(!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-error mb-4" role="alert"></div> }
<form method="get" id="activityFilters" class="card card-body mb-4">
 <div class="flex gap-3 flex-wrap">
  <label class="field">Category<select name="Category" class="input"><option value="">All activity</option>
  @foreach(var c in new[]{"orders","payments","design","inventory","staff","products","categories","customers","reviews","communication"}){<option value="@c" selected="@(f.Category==c)">@c</option>}
  </select></label>
  <label class="field">From (UTC)<input class="input" type="date" name="From" value="@f.From?.ToString("yyyy-MM-dd")" /></label>
  <label class="field">Through (UTC)<input class="input" type="date" name="To" value="@f.To?.ToString("yyyy-MM-dd")" /></label>
  <label class="field">Actor username<input class="input" name="Actor" value="@f.Actor" maxlength="120" placeholder="Username or System" /></label>
  <label class="field">Search activity<input class="input" name="Search" value="@f.Search" maxlength="120" placeholder="Description or order number" /></label>
 </div>
 <details><summary>More filters</summary><div class="flex gap-3 flex-wrap mt-3">
  <label class="field">Activity type<input class="input" name="Type" value="@f.Type" maxlength="80" placeholder="e.g. payment.succeeded" /></label>
  <label class="field">Order number<input class="input" name="Order" value="@f.Order" maxlength="64" placeholder="e.g. DCX-2026-000042" /></label>
  <label class="field">Customer name<input class="input" name="Customer" value="@f.Customer" maxlength="120" /></label>
  <label class="field">Product name<input class="input" name="Product" value="@f.Product" maxlength="120" /></label>
  <label class="field">Staff username<input class="input" name="Staff" value="@f.Staff" maxlength="120" /></label>
  <label class="field">Order ID<input class="input" name="OrderId" value="@f.OrderId" /></label>
  <label class="field">Customer ID<input class="input" name="CustomerId" value="@f.CustomerId" /></label>
  <label class="field">Product ID<input class="input" name="ProductId" value="@f.ProductId" /></label>
  <label class="field">Staff ID<input class="input" name="StaffUserId" value="@f.StaffUserId" /></label>
  <label class="field">Importance<select class="input" name="Importance"><option value="">All</option><option value="normal" selected="@(f.Importance=="normal")">Normal</option><option value="attention" selected="@(f.Importance=="attention")">Needs attention</option></select></label>
 </div></details>
 <div class="flex gap-2 mt-3"><button class="btn btn-primary" type="submit">Apply filters</button><a class="btn btn-secondary" href="/admin/activity">Clear filters</a><button class="btn btn-secondary" id="activityRefresh" type="button">Refresh history</button></div>
</form>
<div id="activityNotice" role="status" class="text-muted mb-3"></div>
<div id="activityRows"><partial name="_Rows" model="Model" /></div>
<script src="~/js/business-activity.js" asp-append-version="true" defer></script>
