@model DeChimex.Contracts.Products.ProductSummaryDto
@using DeChimex.Host
@{
    // Reusable storefront card. ViewData contract (all optional):
    //   ShopBase     "/products" | "/portal/shop"  (link target base)
    //   IsCustomer   bool  — signed-in customer: cards get a real add-to-cart form
    //   WishlistIds  HashSet<Guid> — saved product ids (customer only)
    //   ReturnUrl    string — where wishlist toggles return to
    var p = Model;
    var shopBase = ViewData["ShopBase"] as string ?? "/products";
    var isCustomer = ViewData["IsCustomer"] is true;
    var saved = ViewData["WishlistIds"] is HashSet<Guid> ids && ids.Contains(p.Id);
    var returnUrl = ViewData["ReturnUrl"] as string ?? Context.Request.Path + Context.Request.QueryString;
    var href = $"{shopBase}/{p.Id}";
    var madeToOrder = p.IsMadeToOrder;
}
<article class="pc" data-product-id="@p.Id">
    <a class="pc-media" href="@href" tabindex="-1" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(p.PrimaryImageUrl))
        {
            <img src="@p.PrimaryImageUrl" alt="" loading="lazy" decoding="async" width="400" height="400">
        }
        else
        {
            <span class="pc-noimg">@Html.Raw(CustomerIcons.Svg("image", 34, null, 1.5))</span>
        }
        @if (madeToOrder)
        {
            <span class="pc-flag is-custom">Made to order</span>
        }
        else if (p.IsOutOfStock)
        {
            <span class="pc-flag is-out">Out of stock</span>
        }
        else if (p.IsLowStock)
        {
            <span class="pc-flag is-low">Only @p.AvailableQuantity left</span>
        }
    </a>
    @if (isCustomer)
    {
        <form class="pc-heart-wrap" asp-controller="PortalWishlist" asp-action="@(saved ? "Remove" : "Add")" asp-route-productId="@p.Id" method="post">
            <input type="hidden" name="returnUrl" value="@returnUrl">
            <button type="submit" class="pc-heart @(saved ? "is-saved" : "")" aria-pressed="@(saved ? "true" : "false")" aria-label="@(saved ? "Remove from wishlist" : "Save to wishlist"): @p.Name">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="@(saved ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
            </button>
        </form>
    }
    <div class="pc-body">
        <div class="pc-cat">@p.CategoryName</div>
        <h3 class="pc-name"><a href="@href">@p.Name</a></h3>
        <div class="pc-price">@CustomerPresentation.Money(p.SellingPrice)@if (madeToOrder) { <small>from</small> }</div>
        <div class="pc-cta">
            @if (madeToOrder)
            {
                <a class="btn btn-outline" href="@href">@Html.Raw(CustomerIcons.Svg("brush", 16)) Customize</a>
            }
            else if (p.IsOutOfStock)
            {
                <a class="btn is-out" href="@href" aria-disabled="true">Out of stock</a>
            }
            else if (isCustomer)
            {
                <form asp-controller="PortalShop" asp-action="AddToCart" asp-route-id="@p.Id" method="post">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="btn btn-primary">@Html.Raw(CustomerIcons.Svg("cart", 16)) Add to cart</button>
                </form>
            }
            else
            {
                <a class="btn btn-primary" href="/portal/shop/@p.Id">@Html.Raw(CustomerIcons.Svg("cart", 16)) Add to cart</a>
            }
        </div>
    </div>
</article>
