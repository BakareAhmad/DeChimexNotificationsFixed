@model (System.Guid ProductId, string ProductName, bool Saved, string ReturnUrl)
<form asp-controller="PortalWishlist" asp-action="@(Model.Saved ? "Remove" : "Add")" asp-route-productId="@Model.ProductId" method="post" style="margin:0" class="wishlist-form" data-product-id="@Model.ProductId">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <button type="submit" class="btn btn-secondary btn-sm" style="max-width:100%;white-space:normal;text-align:left" aria-pressed="@(Model.Saved ? "true" : "false")" aria-label="@(Model.Saved ? "Remove " + Model.ProductName + " from wishlist" : "Add " + Model.ProductName + " to wishlist")">
        <svg style="flex-shrink:0" width="18" height="18" viewBox="0 0 24 24" fill="@(Model.Saved ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" /></svg>
        <span>@(Model.Saved ? "Remove from wishlist" : "Add to wishlist")</span>
    </button>
</form>
