@{
    ViewData["Title"] = "Home";
    var fullName = ViewData["FullName"] as string ?? "there";
    var permissions = ViewData["Permissions"] as IReadOnlyList<string> ?? new List<string>();
}
<div class="card card-body">
    <h1 class="text-2xl mb-2">Welcome, @fullName</h1>
    <p class="text-muted mb-4">You are signed in. Where to next?</p>
    <div class="flex gap-2 mb-4 flex-wrap">
        <a class="btn btn-primary" href="/admin/dashboard">Open the admin dashboard</a>
        <a class="btn btn-outline" href="/">Go to the storefront</a>
    </div>
    @if (ViewData["IsOwner"] is true)
    {
        <div class="badge badge-neutral mb-4">Owner account</div>
    }
    <details>
        <summary class="text-sm font-semibold" style="cursor:pointer">Your permissions (@permissions.Count)</summary>
        <ul class="mt-2 text-sm text-muted" style="columns:2;list-style:none;padding:0">
            @foreach (var p in permissions)
            {
                <li style="break-inside:avoid">@p</li>
            }
        </ul>
    </details>
</div>
