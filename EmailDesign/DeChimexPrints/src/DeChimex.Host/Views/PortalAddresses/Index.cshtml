@model IReadOnlyList<DeChimex.Contracts.Customers.AddressDto>
@using DeChimex.Host
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Addresses";
    ViewData["ActiveNav"] = "addresses";
}
<div class="cs-wrap cs-wrap-md">
    <partial name="Customer/_AccountTabs" model="@("addresses")" />
    <div class="cs-page-head cs-row-between">
        <h1>Addresses</h1>
        <a class="btn btn-primary btn-sm" asp-action="Add">@Html.Raw(CustomerIcons.Svg("plus", 16)) Add address</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="cs-card">
            @{ var es = new EmptyState(EmptyIcons.Box, "No saved addresses", "Save a delivery address to check out faster next time.", CtaHref: "/portal/addresses/add", CtaText: "Add an address"); }
            <partial name="_EmptyState" model="es" />
        </div>
    }
    else
    {
        <div class="ac-list">
            @foreach (var a in Model)
            {
                <div class="ac-item">
                    <div class="ac-item-main">
                        <div class="ac-item-title">@a.Label @if (a.IsDefault) { <span class="cs-status is-info" style="margin-left:6px">Default</span> }</div>
                        <div class="ac-item-sub">@a.Street, @a.City, @a.State, @a.Country@(string.IsNullOrWhiteSpace(a.PostalCode) ? "" : $" · {a.PostalCode}")</div>
                    </div>
                    <form asp-action="Remove" asp-route-addressId="@a.Id" method="post">
                        <button type="submit" class="btn btn-ghost btn-sm ac-danger" aria-label="Remove @a.Label">@Html.Raw(CustomerIcons.Svg("trash", 15)) Remove</button>
                    </form>
                </div>
            }
        </div>
    }
</div>
