@model (bool StillSubscribed, bool InvalidLink)
@{
    Layout = null;
    ViewData["Title"] = "Unsubscribe";
    var alreadyOut = !Model.StillSubscribed && !Model.InvalidLink;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] · DE-CHIMEX PRINT HUB</title>
    <partial name="_BrandHead" />
    <link rel="stylesheet" href="/css/app.css">
</head>
<body style="background:var(--canvas);margin:0;font-family:'Inter',system-ui,-apple-ui,sans-serif">
    <div style="min-height:100vh;display:grid;place-items:center;padding:24px">
        <main style="width:100%;max-width:420px">
            @* Same brand lockup as the app top bar (.cs-logo + .cs-brand-text, inlined here
               because this standalone page loads app.css only) and the email header, so the
               marketing-email landing page speaks one language. *@
            <div style="display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:26px">
                <span style="width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:var(--brand-grad);overflow:hidden;flex-shrink:0">
                    <img src="/img/logo.png" alt="" width="38" height="38" style="width:100%;height:100%;object-fit:contain;background:#fff;padding:3px">
                </span>
                <span style="line-height:1.05;text-align:left">
                    <span style="display:block;font-weight:800;font-size:14.5px;color:var(--n-900);letter-spacing:-.01em">DE-CHIMEX</span>
                    <span style="display:block;font-size:9.5px;font-weight:700;letter-spacing:.2em;color:var(--primary)">PRINT HUB</span>
                </span>
            </div>
            <div class="card card-body" style="padding:28px 24px">
                @if (Model.InvalidLink)
                {
                    <h1 style="font-size:18px;font-weight:800;color:var(--n-900)">Link not recognised</h1>
                    <p style="font-size:14px;color:var(--n-600);line-height:1.6">This unsubscribe link is invalid or has expired. If you keep receiving marketing emails you didn't ask for, contact us and we'll sort it out.</p>
                }
                else if (alreadyOut)
                {
                    <h1 style="font-size:18px;font-weight:800;color:var(--n-900)">You're unsubscribed ✅</h1>
                    <p style="font-size:14px;color:var(--n-600);line-height:1.6">You will no longer receive marketing emails from DE-CHIMEX PRINT HUB. Order updates, receipts and account-security emails are unaffected.</p>
                }
                else
                {
                    <h1 style="font-size:18px;font-weight:800;color:var(--n-900)">Unsubscribe from marketing emails?</h1>
                    <p style="font-size:14px;color:var(--n-600);line-height:1.6">You'll stop receiving promotions and newsletters from us. You'll still get order updates, receipts and important account emails.</p>
                    <form method="post" asp-action="Confirm" asp-route-token="@Context.Request.RouteValues["token"]" style="margin-top:18px">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary" style="width:100%">Yes, unsubscribe me</button>
                    </form>
                }
                <p style="text-align:center;margin:18px 0 0"><a href="/" style="font-size:13px;color:var(--n-600)">Back to home</a></p>
            </div>
        </main>
    </div>
</body>
</html>
