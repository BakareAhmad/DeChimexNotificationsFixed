@model DeChimex.Contracts.Products.ProductDto
@{
    Layout = "_AdminLayout";
    var canUpdate = ViewBag.CanUpdate is true;
    var canDelete = ViewBag.CanDelete is true;
    var reviews = ViewBag.Reviews as IReadOnlyList<DeChimex.Contracts.Reviews.ReviewDto> ?? Array.Empty<DeChimex.Contracts.Reviews.ReviewDto>();
}
<div class="card" style="max-width:720px">
    <div class="card-head">
        <h3>@Model.Name</h3>
        <div class="flex items-center gap-2">
            <a class="btn btn-outline btn-sm" asp-action="Index" aria-label="Back to product list">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
                Back to list
            </a>
            @if (canUpdate) { <a class="btn btn-outline btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> }
        </div>
    </div>
    <div class="card-body">
        <div class="mt-4">
            <div class="flex items-center justify-between mb-2">
                <h4 style="margin:0">Reviews (@reviews.Count)</h4>
            </div>
            @if (reviews.Count == 0)
            {
                
    var es = new EmptyState(EmptyIcons.Star, "No reviews yet", "Customer reviews will appear here after the first one is submitted.", Compact: true);
                <partial name="_EmptyState" model="es" />
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Customer</th><th>Rating</th><th>Review</th><th>Status</th>@if (canUpdate) { <th>Actions</th> }</tr></thead>
                    <tbody>
                        @foreach (var r in reviews)
                        {
                            <tr>
                                <td>@r.CustomerName<div class="text-xs text-muted">@r.CreatedDateUtc.ToLocalTime().ToString("d MMM yyyy")</div></td>
                                <td>@r.Rating / 5</td>
                                <td style="max-width:280px">
                                    @if (!string.IsNullOrWhiteSpace(r.Title)) { <div class="font-semibold text-sm">@r.Title</div> }
                                    @if (!string.IsNullOrWhiteSpace(r.Comment)) { <div class="text-xs text-muted">@r.Comment</div> }
                                    @if (string.IsNullOrWhiteSpace(r.Title) && string.IsNullOrWhiteSpace(r.Comment)) { <span class="text-muted">(rating only)</span> }
                                </td>
                                <td>
                                    @if (r.IsApproved) { <span class="badge badge-success">Approved</span> }
                                    else { <span class="badge badge-warning">Pending</span> }
                                </td>
                                @if (canUpdate)
                                {
                                    <td style="text-align:right;white-space:nowrap">
                                        @if (!r.IsApproved)
                                        {
                                            <form asp-action="ApproveReview" asp-route-id="@Model.Id" asp-route-reviewId="@r.Id" method="post" style="display:inline">
                                                <button class="btn btn-outline btn-sm" type="submit">Approve</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="RejectReview" asp-route-id="@Model.Id" asp-route-reviewId="@r.Id" method="post" style="display:inline">
                                                <button class="btn btn-ghost btn-sm" type="submit">Hide</button>
                                            </form>
                                        }
                                        <form asp-action="DeleteReview" asp-route-id="@Model.Id" asp-route-reviewId="@r.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this review? This cannot be undone.');">
                                            <button class="btn btn-ghost btn-sm" type="submit" style="color:var(--danger)">Delete</button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="g" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px">
            <div><div class="text-xs text-muted">SKU</div><div>@Model.Sku</div></div>
            <div><div class="text-xs text-muted">Category</div><div>@Model.CategoryName</div></div>
            <div><div class="text-xs text-muted">Price</div><div>₦@Model.SellingPrice.ToString("N2")</div></div>
            <div><div class="text-xs text-muted">Available</div><div>@Model.AvailableQuantity</div></div>
            <div><div class="text-xs text-muted">Low stock threshold</div><div>@Model.LowStockThreshold</div></div>
            <div><div class="text-xs text-muted">Status</div>
                <div>
                    @if (!Model.IsActive) { <span class="badge badge-neutral">Inactive</span> }
                    else if (Model.IsOutOfStock) { <span class="badge badge-error">Out of stock</span> }
                    else if (Model.IsLowStock) { <span class="badge badge-warning">Low stock</span> }
                    else { <span class="badge badge-success">Active</span> }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="mt-4">
                <div class="text-xs text-muted">Description</div>
                <p>@Model.Description</p>
            </div>
        }

        <div class="mt-4">
            <div class="text-xs text-muted">Images</div>
            @if (Model.Images.Count == 0)
            {
                
    var es2 = new EmptyState(EmptyIcons.Image, "No images yet", "Upload product photos to give this listing a real face.", CtaHref: canUpdate ? $"/admin/products/edit/{Model.Id}" : null, CtaText: "Add images", Compact: true);
                <partial name="_EmptyState" model="es2" />
            }
            else
            {
                <div class="flex gap-3 mt-2" style="flex-wrap:wrap">
                    @{
                        // Carousel order management: moving an image re-submits the full
                        // order; the new first image becomes the primary automatically.
                        var imgs = Model.Images.OrderBy(x => x.DisplayOrder).ToList();
                        var ids = imgs.Select(x => x.Id).ToList();
                    }
                    @for (var i = 0; i < imgs.Count; i++)
                    {
                        var img = imgs[i];
                        var earlier = new List<Guid>(ids);
                        if (i > 0) { earlier[i] = ids[i - 1]; earlier[i - 1] = ids[i]; }
                        var later = new List<Guid>(ids);
                        if (i < imgs.Count - 1) { later[i] = ids[i + 1]; later[i + 1] = ids[i]; }
                        <!-- Uniform 140px cell: the Primary / n-N badges anchor to the fixed
                             image box, and the icon toolbar below is exactly as wide as the
                             thumbnail, so every column lines up. -->
                        <div style="width:140px">
                            <div style="position:relative;width:140px;height:140px">
                                <img src="@img.Url" alt="@(img.AltText ?? Model.Name)" style="width:140px;height:140px;object-fit:cover;border-radius:8px;border:1px solid var(--n-200)">
                                <span style="position:absolute;top:6px;right:6px;background:rgba(15,23,42,.62);color:#fff;font-size:10px;font-weight:600;padding:2px 7px;border-radius:6px">@(i + 1)/@imgs.Count</span>
                                @if (img.IsPrimary)
                                {
                                    <span style="position:absolute;top:6px;left:6px;background:#0F172A;color:#fff;font-size:10px;font-weight:600;padding:2px 7px;border-radius:6px">Primary</span>
                                }
                            </div>
                            @if (canUpdate)
                            {
                                <div style="display:flex;gap:4px;margin-top:6px">
                                    <form asp-action="ReorderImages" asp-route-id="@Model.Id" method="post">
                                        @foreach (var gid in earlier) { <input type="hidden" name="orderedIds" value="@gid" /> }
                                        <button class="icon-btn" style="width:32px;height:32px" type="submit" title="Move earlier" aria-label="Move image @(i + 1) earlier" @(i == 0 ? "disabled" : "")>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                                        </button>
                                    </form>
                                    <form asp-action="ReorderImages" asp-route-id="@Model.Id" method="post">
                                        @foreach (var gid in later) { <input type="hidden" name="orderedIds" value="@gid" /> }
                                        <button class="icon-btn" style="width:32px;height:32px" type="submit" title="Move later" aria-label="Move image @(i + 1) later" @(i == imgs.Count - 1 ? "disabled" : "")>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                        </button>
                                    </form>
                                    <form asp-action="SetImagePrimary" asp-route-id="@Model.Id" asp-route-imageId="@img.Id" method="post">
                                        <button class="icon-btn" style="width:32px;height:32px" type="submit" title="@(img.IsPrimary ? "Primary image" : "Make primary")" aria-label="Make image @(i + 1) primary" @(img.IsPrimary ? "disabled" : "")>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="@(img.IsPrimary ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                                        </button>
                                    </form>
                                    <form asp-action="RemoveImage" asp-route-id="@Model.Id" asp-route-imageId="@img.Id" method="post" onsubmit="return confirm('Remove this image?');">
                                        <button class="icon-btn" style="width:32px;height:32px;border-color:rgba(220,38,38,.35);color:#dc2626" type="submit" title="Remove image" aria-label="Remove image @(i + 1)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
@if (canDelete)
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this product?')">Delete product</button>
    </form>
}
