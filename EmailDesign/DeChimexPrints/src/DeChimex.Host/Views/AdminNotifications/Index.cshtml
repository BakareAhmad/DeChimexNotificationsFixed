@model IReadOnlyList<DeChimex.Contracts.Notifications.NotificationDto>
@{
    Layout = "_AdminLayout";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
    var returnToHistory = Url.Action("Index") ?? "/admin/notifications";
}
<div class="toolbar" style="margin-bottom:16px">
    <a class="btn btn-outline btn-sm" asp-action="Index" asp-route-unreadOnly="@(!(ViewBag.UnreadOnly is true))">
        @(ViewBag.UnreadOnly is true ? "Show all" : "Unread only")
    </a>
    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post" style="display:inline;margin:0">
            <button type="submit" class="btn btn-primary btn-sm">Mark all as read (@unreadCount)</button>
        </form>
    }
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-muted">No notifications.</div>
        }
        @foreach (var n in Model)
        {
            <div class="flex items-start gap-3" data-notification-id="@n.Id" data-is-read="@n.IsRead.ToString().ToLowerInvariant()" style="padding:12px 0;border-bottom:1px solid var(--n-100)">
                <div class="flex-1">
                    <div class="font-semibold" style="font-size:14px">@n.Title</div>
                    <div class="text-sm text-muted">@n.Message</div>
                    <div class="text-xs text-muted mt-1">@n.CreatedDateUtc.ToLocalTime().ToString("d MMM yyyy HH:mm")</div>
                </div>
                <div class="flex items-center gap-2">
                    @if (!n.IsRead)
                    {
                        <span class="badge badge-primary">New</span>
                        <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" style="display:inline;margin:0">
                            <input type="hidden" name="returnUrl" value="@returnToHistory" />
                            <button type="submit" class="btn btn-ghost btn-sm">Mark read</button>
                        </form>
                    }
                    else
                    {
                        <span class="badge badge-neutral">Read</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(n.Link))
                    {
                        <a class="btn btn-outline btn-sm"
                           href="@n.Link"
                           data-notification-open-id="@n.Id"
                           data-notification-is-read="@n.IsRead.ToString().ToLowerInvariant()">Open</a>
                    }
                </div>
            </div>
        }
    </div>
</div>
