@model DeChimex.Host.Models.Admin.ChangePasswordFormViewModel
@{ var forced = ViewBag.Forced is true; }
<div style="max-width:520px">
    @if (forced)
    {
        <div class="dv-warnbox" style="margin-bottom:12px">You must choose a new password before using the Developer Portal.</div>
    }
    <section class="dv-card">
        <h2>Change your password</h2>
        <form method="post" action="/dev/account/password" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="dv-flash dv-flash-bad" style="display:@(ViewData.ModelState.ErrorCount > 0 && ViewData.ModelState[""]?.Errors.Count > 0 ? "block" : "none")"></div>
            <div class="dv-grid" style="gap:10px">
                <label class="dv-small dv-muted" style="display:flex;flex-direction:column;gap:4px">Current password
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" style="color:#fca5a5"></span>
                </label>
                <label class="dv-small dv-muted" style="display:flex;flex-direction:column;gap:4px">New password
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" style="color:#fca5a5"></span>
                </label>
                <label class="dv-small dv-muted" style="display:flex;flex-direction:column;gap:4px">Confirm new password
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" style="color:#fca5a5"></span>
                </label>
                <div><button class="dv-btn" type="submit">Update password</button></div>
            </div>
        </form>
    </section>
</div>
