@model DeChimex.Host.Models.Admin.RoleFormViewModel
@{
    Layout = "_AdminLayout";
    var isEdit = Model.Id != Guid.Empty;
}
<div class="card" style="max-width:520px">
    <div class="card-head"><h3>@(isEdit ? "Edit role" : "New role")</h3></div>
    <div class="card-body">
        <form asp-action="@(isEdit ? "RoleEdit" : "RoleCreate")" asp-route-id="@(isEdit ? Model.Id : null)" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4" role="alert"></div>
            <div class="field">
                <label class="label" asp-for="Name">Name <span class="req">*</span></label>
                <input class="input" asp-for="Name" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="field">
                <label class="label" asp-for="Description">Description</label>
                <textarea class="input" asp-for="Description" rows="2"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
            <div class="flex items-center gap-2 mt-4">
                <button class="btn btn-primary" type="submit">@(isEdit ? "Save changes" : "Create role")</button>
                <a class="btn btn-outline" asp-action="Roles">Cancel</a>
            </div>
        </form>
    </div>
</div>
