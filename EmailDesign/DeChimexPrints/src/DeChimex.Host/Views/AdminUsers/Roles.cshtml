@model IReadOnlyList<DeChimex.Contracts.Auth.RoleDto>
@{
    Layout = "_AdminLayout";
    var canAssign = ViewBag.CanAssign is true;
}
<div class="flex justify-end mb-3">
    @if (canAssign)
    {
        <a class="btn btn-primary" asp-action="RoleCreate">New role</a>
    }
</div>
<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Role</th><th>Description</th><th>Permissions</th><th>Users</th><th>Type</th>@if (canAssign) { <th>Actions</th> }</tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                    var es = new EmptyState(EmptyIcons.User, "No roles yet", "Roles define which permissions each team member has.");
                <tr><td colspan="6" class="table-empty">
                <partial name="_EmptyState" model="es" /></td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td class="font-semibold">@r.Name</td>
                    <td class="text-muted">@(r.Description ?? "-")</td>
                    <td class="text-muted" style="max-width:320px">@r.Permissions.Count</td>
                    <td>@r.UserCount</td>
                    <td>@if (r.IsSystemRole) { <span class="badge badge-neutral">System</span> } else { <span class="badge badge-success">Custom</span> }</td>
                    @if (canAssign)
                    {
                        <td style="text-align:right;white-space:nowrap">
                            <a class="btn btn-ghost btn-sm" asp-action="RolePermissions" asp-route-id="@r.Id">Permissions</a>
                            @if (!r.IsSystemRole)
                            {
                                <a class="btn btn-outline btn-sm" asp-action="RoleEdit" asp-route-id="@r.Id">Edit</a>
                                <form asp-action="RoleDelete" asp-route-id="@r.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this role?');">
                                    <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger)">Delete</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
