@model IReadOnlyList<DeChimex.Host.Models.Admin.CustomerReportRow>
@{
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-head"><h3>Customer report</h3></div>
    <div class="card-body">
        <table class="table">
            <thead><tr><th>Customer</th><th>Orders</th><th>Lifetime spend</th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="3" class="text-muted">No customers in range.</td></tr> }
                @foreach (var r in Model)
                {
                    <tr><td>@r.Customer</td><td>@r.Orders</td><td>₦@r.LifetimeSpend.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
