@model IReadOnlyList<DeChimex.Host.Models.Admin.LowStockRow>
@{
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-head"><h3>Low stock</h3></div>
    <div class="card-body">
        <table class="table">
            <thead><tr><th>Product</th><th>Available</th><th>Threshold</th><th>Status</th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="4" class="text-muted">No low-stock items.</td></tr> }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Product</td><td>@r.Available</td><td>@r.Threshold</td>
                        <td>@if (r.Status == "Out of stock") { <span class="badge badge-error">@r.Status</span> } else { <span class="badge badge-warning">@r.Status</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
