@model IReadOnlyList<DeChimex.Host.Models.Admin.ProductReportRow>
@{
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-head" style="display:flex;justify-content:space-between;align-items:center;gap:12px"><h3>Product performance</h3>
        <a class="btn btn-secondary btn-sm" href="?format=csv" title="Download as CSV">Export CSV</a></div>
    <div class="card-body">
        <table class="table">
            <thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="3" class="text-muted">No product sales in range.</td></tr> }
                @foreach (var r in Model)
                {
                    <tr><td>@r.Product</td><td>@r.Units</td><td>₦@r.Revenue.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
