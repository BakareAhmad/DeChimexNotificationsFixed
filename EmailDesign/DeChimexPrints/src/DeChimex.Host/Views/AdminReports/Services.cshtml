@model IReadOnlyList<DeChimex.Host.Models.Admin.ServiceReportRow>
@{
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-head" style="display:flex;justify-content:space-between;align-items:center;gap:12px"><h3>Service report</h3>
        <a class="btn btn-secondary btn-sm" href="?format=csv" title="Download as CSV">Export CSV</a></div>
    <div class="card-body">
        <table class="table">
            <thead><tr><th>Service</th><th>Bookings</th><th>Revenue</th></tr></thead>
            <tbody>
                @if (Model.Count == 0) { <tr><td colspan="3" class="text-muted">No service bookings in range.</td></tr> }
                @foreach (var r in Model)
                {
                    <tr><td>@r.Service</td><td>@r.Bookings</td><td>₦@r.Revenue.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
