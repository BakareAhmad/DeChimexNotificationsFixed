@model ForgotPasswordViewModel
@using DeChimex.Host
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
    var sent = ViewBag.Sent is true;
}
<h1>Forgot your password?</h1>
<p class="au-sub">Enter the email on your account and we'll send you a reset link.</p>

@if (sent)
{
    <div class="alert alert-success mb-4" role="status">If an account exists for that email, a password reset link has been sent. Please check your inbox (and spam folder).</div>
}

<form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4" role="alert"></div>
    <div class="field mb-4">
        <label class="label" asp-for="Email">Email <span class="req" aria-hidden="true">*</span></label>
        <input class="input" asp-for="Email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" autofocus />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Send reset link</button>
</form>

<p class="au-foot"><a href="/Account/Login">Back to sign in</a></p>
