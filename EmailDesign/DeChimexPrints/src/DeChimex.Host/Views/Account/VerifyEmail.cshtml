@model VerifyEmailViewModel
@using DeChimex.Host
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify email";
}
<h1>Verify your email</h1>
<p class="au-sub">Paste the token (or the full link) from the email we sent you to finish setting up your account.</p>

<form asp-controller="Account" asp-action="VerifyEmail" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4" role="alert"></div>
    <div class="field mb-4">
        <label class="label" asp-for="Email">Email <span class="req" aria-hidden="true">*</span></label>
        <input class="input" asp-for="Email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="field mb-4">
        <label class="label" asp-for="Token">Verification token or link <span class="req" aria-hidden="true">*</span></label>
        <input class="input" asp-for="Token" type="text" placeholder="Paste the token or the full link from your email" />
        <span asp-validation-for="Token" class="field-error"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Verify email</button>
</form>

<form asp-controller="Account" asp-action="ResendVerification" method="post" class="mt-4">
    @if (string.IsNullOrWhiteSpace(Model.Email))
    {
        <div class="field mb-3">
            <label class="label" for="resendEmail">Didn't get it? Enter your email to resend</label>
            <input class="input" id="resendEmail" name="email" type="email" inputmode="email" placeholder="you@example.com" />
        </div>
    }
    else
    {
        <input type="hidden" name="email" value="@Model.Email" />
    }
    <button type="submit" class="btn btn-outline btn-block">Resend verification email</button>
</form>

<p class="au-foot"><a href="/Account/Login">Back to sign in</a></p>
