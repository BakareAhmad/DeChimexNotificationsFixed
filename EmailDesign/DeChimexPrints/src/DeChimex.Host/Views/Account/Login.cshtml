@model LoginViewModel
@using DeChimex.Host
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<h1>Welcome back</h1>
<p class="au-sub">Sign in to track orders, chat with our team and check out faster.</p>

<form asp-controller="Account" asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" value="@(ViewData["ReturnUrl"] ?? Model?.ReturnUrl)" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4" role="alert"></div>

    <div class="field mb-4">
        <label class="label" asp-for="Email">Email <span class="req" aria-hidden="true">*</span></label>
        <input class="input" asp-for="Email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" autofocus />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="field mb-4">
        <label class="label" asp-for="Password">Password <span class="req" aria-hidden="true">*</span></label>
        <div class="au-pw">
            <input class="input" asp-for="Password" type="password" autocomplete="current-password" placeholder="Your password" />
            <button type="button" data-pw-toggle aria-label="Show password">Show</button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="cs-row-between mb-4">
        <label class="cs-check" for="remember"><input type="checkbox" id="remember" name="remember" checked> Remember me</label>
        <a href="/Account/ForgotPassword" class="cs-link cs-small">Forgot password?</a>
    </div>

    <button type="submit" class="btn btn-primary btn-lg btn-block">Sign in</button>
</form>

<p class="au-foot">New here? <a href="/Account/Register@(string.IsNullOrEmpty(Model?.ReturnUrl) ? "" : "?returnUrl=" + Uri.EscapeDataString(Model.ReturnUrl))">Create an account</a></p>
