@model ResetPasswordViewModel
@using DeChimex.Host
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}
<h1>Choose a new password</h1>
<p class="au-sub">Use at least 8 characters, including a number and a letter.</p>

<form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4" role="alert"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <div class="field mb-4">
        <label class="label" asp-for="NewPassword">New password <span class="req" aria-hidden="true">*</span></label>
        <div class="au-pw">
            <input class="input" asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="New password" autofocus />
            <button type="button" data-pw-toggle aria-label="Show password">Show</button>
        </div>
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>
    <div class="field mb-4">
        <label class="label" asp-for="ConfirmPassword">Confirm password <span class="req" aria-hidden="true">*</span></label>
        <input class="input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Repeat your new password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Reset password</button>
</form>

<p class="au-foot"><a href="/Account/Login">Back to sign in</a></p>
