@model DeChimex.Host.Models.Portal.ProfileFormViewModel
@using DeChimex.Host
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Profile";
    ViewData["ActiveNav"] = "profile";
}
<div class="cs-wrap cs-wrap-md">
    <partial name="Customer/_AccountTabs" model="@("profile")" />
    <div class="cs-page-head"><h1>Profile</h1></div>

    <div class="ac-grid">
        <section class="cs-card cs-card-pad" aria-labelledby="profHeading">
            <h2 id="profHeading" class="cs-card-title">Your details</h2>
            <form asp-action="Index" method="post" style="margin-top:10px">
                <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4" role="alert"></div>
                <div class="au-grid-2">
                    <div class="field">
                        <label class="label" asp-for="FirstName">First name <span class="req">*</span></label>
                        <input class="input" asp-for="FirstName" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label class="label" asp-for="LastName">Last name <span class="req">*</span></label>
                        <input class="input" asp-for="LastName" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="field-error"></span>
                    </div>
                </div>
                <div class="field">
                    <label class="label" asp-for="Phone">Phone</label>
                    <input class="input" asp-for="Phone" type="tel" inputmode="tel" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>
                <button class="btn btn-primary" type="submit">Save changes</button>
            </form>
        </section>

        <section class="cs-card cs-card-pad" aria-labelledby="secHeading">
            <h2 id="secHeading" class="cs-card-title">Security</h2>
            <p class="cs-card-sub">Keep your account safe with a strong password.</p>
            <a class="btn btn-outline" asp-action="ChangePassword" style="margin-top:10px">Change password</a>
            <div class="cs-menu-sep" style="margin:16px 0"></div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-ghost ac-danger">@Html.Raw(CustomerIcons.Svg("logout", 16)) Sign out</button>
            </form>
        </section>
    </div>
</div>
