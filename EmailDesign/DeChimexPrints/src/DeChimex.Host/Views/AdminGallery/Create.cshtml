@model DeChimex.Host.Models.Admin.GalleryFormViewModel
@{
    Layout = "_AdminLayout";
}
<div class="card" style="max-width:520px">
    <div class="card-head"><h3>New media</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @await Html.PartialAsync("_GalleryForm", Model)
            <div class="flex items-center gap-2 mt-4">
                <button class="btn btn-primary" type="submit">Save</button>
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
