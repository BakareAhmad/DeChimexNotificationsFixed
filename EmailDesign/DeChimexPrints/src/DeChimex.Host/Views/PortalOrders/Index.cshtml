@model IReadOnlyList<DeChimex.Contracts.Orders.OrderSummaryDto>
@using DeChimex.Host
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "My orders";
    ViewData["ActiveNav"] = "orders";
    var filter = (Context.Request.Query["show"].ToString() ?? "").ToLowerInvariant();
    bool IsOpen(DeChimex.Contracts.Orders.OrderSummaryDto o) => !CustomerPresentation.IsClosed(o.Status) && o.Status is not ("Completed" or "Delivered");
    var shown = filter switch
    {
        "open" => Model.Where(IsOpen).ToList(),
        "done" => Model.Where(o => o.Status is "Completed" or "Delivered").ToList(),
        "custom" => Model.Where(o => o.Kind == "Custom" || CustomerPresentation.IsCustomStatus(o.Status)).ToList(),
        _ => Model.ToList()
    };
    string Tab(string key) => key == filter || (key == "" && string.IsNullOrEmpty(filter)) ? "chip is-active" : "chip";
}

<div class="cs-wrap">
    <partial name="Customer/_AccountTabs" model="@("orders")" />
    <div class="cs-page-head cs-row-between">
        <h1>My orders</h1>
        <a class="cs-link cs-small" href="/portal/orders/track">Track by number</a>
    </div>

    @if (Model.Count > 0)
    {
        <div class="chips" role="tablist" aria-label="Filter orders">
            <a class="@Tab("")" href="/portal/orders">All <span class="chip-n">@Model.Count</span></a>
            <a class="@Tab("open")" href="/portal/orders?show=open">In progress <span class="chip-n">@Model.Count(IsOpen)</span></a>
            <a class="@Tab("custom")" href="/portal/orders?show=custom">Custom</a>
            <a class="@Tab("done")" href="/portal/orders?show=done">Completed</a>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="cs-card">
            @{ var es = new EmptyState(EmptyIcons.Cart, "No orders yet", "Orders you place will appear here with live status updates.", CtaHref: "/portal/shop", CtaText: "Start shopping"); }
            <partial name="_EmptyState" model="es" />
        </div>
    }
    else if (shown.Count == 0)
    {
        <div class="cs-card">
            @{ var es2 = new EmptyState(EmptyIcons.Box, "Nothing here", "No orders match this filter.", CtaHref: "/portal/orders", CtaText: "Show all orders", Compact: true); }
            <partial name="_EmptyState" model="es2" />
        </div>
    }
    else
    {
        <div class="od-list">
            @foreach (var o in shown) { <partial name="Customer/_OrderCard" model="o" /> }
        </div>
    }
</div>
