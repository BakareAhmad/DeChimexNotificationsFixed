{
  "id": "de-chimex-print-hub",
  "name": "DE-CHIMEX PRINT HUB",
  "short_name": "DE-CHIMEX",
  "description": "Order prints, custom designs and signage from DE-CHIMEX PRINTS, and follow your order in real time.",
  "icons": [
    { "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["shopping", "business"],
  "shortcuts": [
    {
      "name": "Shop products",
      "short_name": "Shop",
      "url": "/products",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Track an order",
      "short_name": "Track",
      "url": "/portal/orders/track",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Custom printing",
      "short_name": "Custom",
      "url": "/services",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
